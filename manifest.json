{
  "author": {
    "email": "manhgdev@gmail.com"
  },
  "name": "VEO Automation - Auto VEO & Nano Banana on Google Flow",
  "description": "Auto VEO & Nano Banana your prompts at scale. Batch generate and auto-download videos and images on Google Flow.",
  "version": "1.0.0",
  "version_name": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_title": "VEO Automation"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content/content.js"],
      "matches": ["*://labs.google/*"],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "offline_enabled": true,
  "host_permissions": ["*://labs.google/*", "*://zivofly.com/*"],
  "permissions": [
    "storage",
    "tabs",
    "background",
    "sidePanel",
    "activeTab",
    "downloads",
    "debugger",
    "cookies",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "matches": ["*://labs.google/*"],
      "resources": [
        "content/upload-hook.js",
        "content/content.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
